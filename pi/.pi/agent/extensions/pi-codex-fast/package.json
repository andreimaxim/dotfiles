{
  "name": "@andreimaxim/pi-codex-fast",
  "version": "0.1.0",
  "description": "Derived fast-tier model for openai-codex GPT-5.4 in Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test 'test/*.test.ts'",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage 'test/*.test.ts'",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "oxlint && oxfmt --check ."
  },
  "devDependencies": {
    "@mariozechner/pi-ai": "^0.57.1",
    "@mariozechner/pi-coding-agent": "^0.57.1",
    "@typescript/native-preview": "^7.0.0-dev.20260217.1",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
