#!/usr/bin/env bash
set -euo pipefail

required_version=2026.7.12
installed_version=
if [[ -x "$HOME/.local/bin/mise" ]]; then
  installed_version=$("$HOME/.local/bin/mise" --version | awk '{ print $1 }')
fi

if [[ "$installed_version" != "$required_version" ]]; then
  curl --proto '=https' --tlsv1.2 --silent --show-error --fail --location https://mise.run |
    MISE_VERSION="v$required_version" MISE_INSTALL_PATH="$HOME/.local/bin/mise" sh
fi
"$HOME/.local/bin/mise" --version
