#!/bin/sh
case " $* " in
  *" -Y sign "*) ;;
  *) exec ssh-keygen "$@" ;;
esac
if command -v op-ssh-sign-wsl.exe >/dev/null 2>&1; then
  exec op-ssh-sign-wsl.exe "$@"
fi
if [ -x /opt/1Password/op-ssh-sign ]; then
  exec /opt/1Password/op-ssh-sign "$@"
fi
echo "1Password SSH signing helper not found" >&2
exit 127
