# Nix / direnv
/.direnv/
/result
/result-*

# Bundler (project-scoped install dir, set by flake.nix)
/vendor/bundle/
/vendor/ruby/
/.bundle/

# Editor tooling (project ruby-lsp GEM_HOME + its composed bundle, see .envrc)
/.gem/
/.ruby-lsp/

# Environment
.env
.env.local

# Rails defaults
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/coverage/
/storage/*
!/storage/.keep

# Credentials keys must never be committed
/config/master.key
/config/credentials/*.key
