# Reload direnv when the flake OR the pinned Ruby changes. Register these inputs
# before `use flake` so nix-direnv cannot refresh a stale cached shell first.
watch_file flake.nix flake.lock .ruby-version

# In a git repo, the git fetcher copies only tracked files into the store — so
# .env/master.key and other secrets never land in /nix/store. Before `git init`
# (fresh scaffold, no secrets yet), path:. bypasses the git-tree-purity check
# that would otherwise reject an untracked flake.nix.
if [ -d .git ]; then
  use flake .
else
  use flake path:.
fi

# Keep app/service configuration out of flake.nix. Rails also reads this through
# dotenv-rails, but direnv makes the same vars available to shell tools.
dotenv_if_exists .env

# Project-local gem home: any manual `gem install` stays here instead of the shared
# ~/.local/share/gem bucket. (bundler ignores this; it uses BUNDLE_PATH.) Scoped by
# Ruby version so a Ruby change gets a fresh dir and native exts don't go ABI-stale.
ruby_version="$(ruby -e 'print RUBY_VERSION')"
export GEM_HOME="$(expand_path ".gem/$ruby_version")"
PATH_add "$GEM_HOME/bin"

# Editor tooling: editors like Zed need a ruby-lsp on PATH — they don't reliably
# auto-install one. Install an unwrapped ruby-lsp into GEM_HOME (first on PATH);
# run directly it composes a bundle against this project's Gemfile (full app-gem
# awareness, nothing added to the Gemfile). `debug` is omitted — a Rails Gemfile
# already ships it, so the composed bundle gets it from there. `gem list -i` makes
# this a no-op after the first run.
if ! gem list -i ruby-lsp >/dev/null 2>&1; then
  log_status "installing ruby-lsp (+ ruby-lsp-rails) into $GEM_HOME …"
  gem install --no-document ruby-lsp ruby-lsp-rails
fi
